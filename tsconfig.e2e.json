{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Specs run in Node but pass callbacks into the page (window.evaluate), so they need both.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "tsBuildInfoFile": "./node_modules/.cache/tsbuildinfo/e2e.tsbuildinfo"
  },
  "include": ["playwright.config.ts", "tests/e2e/**/*"]
}
